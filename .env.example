# PostgreSQL Connection String (Supabase, Neon, AWS RDS, hoặc Local Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/tiennghich_db?schema=public"

# HMAC Secret dành cho giao tiếp bảo mật giữa Game Tool (C#/C++/Python) và Web API
# Client Tool phải lưu trữ secret này an toàn và dùng để ký request HMAC-SHA256
CLIENT_API_HMAC_SECRET="TN_SECRET_MA_DAO_9999_HUYET_SAC_CYBERPUNK"

# Webhook Secret xác thực dữ liệu biến động số dư từ cổng thanh toán VietQR (SePay / Casso / Web2M)
PAYMENT_WEBHOOK_SECRET="SEC_PAYMENT_VIETQR_SECRET_TOKEN_247"

# Secret Key cho các tác vụ quản trị tối cao (Đền bù bảo trì hàng loạt, Sinh Key sỉ)
ADMIN_SECRET_KEY="TN_ADMIN_SUPER_SECRET_KEY_9999"

# JWT Secret cho Token đăng nhập tài khoản
JWT_SECRET="TN_JWT_SUPER_SECURE_KEY_2026_MA_DAO"

# URL công khai của Website
NEXT_PUBLIC_APP_URL="https://tiennghich.vn"
