// ============================================================================
// PRISMA SCHEMA - TIÊN NGHỊCH AUTO LICENSING & E-COMMERCE PLATFORM
// Production-Ready Schema with Strict Foreign Keys, Indexes & Constraints
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
  RESELLER
}

enum PlanType {
  DAY
  WEEK
  MONTH
  LIFETIME
  RESELLER_BULK
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum KeyStatus {
  UNACTIVATED
  ACTIVE
  EXPIRED
  BANNED
}

enum TransactionType {
  DEPOSIT
  PURCHASE
  REFUND
  HWID_RESET_FEE
  REVENUE_SHARE
  SYSTEM_ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentProvider {
  VIETQR
  SEPAY
  CASSO
  WEB2M
  MOMO
  MANUAL_ADMIN
}

enum DiscountType {
  PERCENT
  FIXED_AMOUNT
}

enum ResetByType {
  USER
  ADMIN
  SYSTEM
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ReleaseChannel {
  STABLE
  BETA
}

// ----------------------------------------------------------------------------
// MODELS
// ----------------------------------------------------------------------------

model User {
  id                   String        @id @default(uuid())
  email                String        @unique
  username             String        @unique
  passwordHash         String
  role                 UserRole      @default(USER)
  balance              Decimal       @default(0.00) @db.Decimal(14, 2)
  totalDeposited       Decimal       @default(0.00) @db.Decimal(14, 2)
  totalSpent           Decimal       @default(0.00) @db.Decimal(14, 2)
  is2FaEnabled         Boolean       @default(false)
  twoFactorSecret      String?
  hwidResetFreeQuota   Int           @default(3)
  hwidResetCountMonth  Int           @default(0)
  hwidResetLastDate    DateTime?
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  orders               Order[]
  licenseKeys          LicenseKey[]
  transactions         Transaction[]
  auditLogs            AuditLog[]
  tickets              Ticket[]
  ticketMessages       TicketMessage[]

  @@index([email])
  @@index([username])
  @@index([role])
}

model ProductPlan {
  id                    String        @id @default(uuid())
  code                  String        @unique
  name                  String
  description           String?       @db.Text
  planType              PlanType      @default(MONTH)
  durationDays          Int           @default(30)
  durationHours         Int           @default(720)
  price                 Decimal       @db.Decimal(12, 2)
  originalPrice         Decimal?      @db.Decimal(12, 2)
  isLifetime            Boolean       @default(false)
  isResellerTier        Boolean       @default(false)
  minQtyForDiscount     Int           @default(1)
  discountPercent       Decimal       @default(0.00) @db.Decimal(5, 2)
  maxAllowedHwidResets  Int           @default(3)
  features              Json?
  sortOrder             Int           @default(0)
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  orders                Order[]
  licenseKeys           LicenseKey[]

  @@index([code])
  @@index([isActive])
  @@index([sortOrder])
}

model Voucher {
  id                    String        @id @default(uuid())
  code                  String        @unique
  discountType          DiscountType  @default(PERCENT)
  discountValue         Decimal       @db.Decimal(12, 2)
  minOrderAmount        Decimal       @default(0.00) @db.Decimal(12, 2)
  maxDiscountAmount     Decimal?      @db.Decimal(12, 2)
  maxUsage              Int           @default(100)
  currentUsage          Int           @default(0)
  expiresAt             DateTime?
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  orders                Order[]

  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
}

model Order {
  id                    String        @id @default(uuid())
  orderCode             String        @unique
  userId                String
  planId                String
  voucherId             String?
  quantity              Int           @default(1)
  unitPrice             Decimal       @db.Decimal(12, 2)
  discountAmount        Decimal       @default(0.00) @db.Decimal(12, 2)
  finalAmount           Decimal       @db.Decimal(12, 2)
  status                OrderStatus   @default(PENDING)
  ipAddress             String?
  userAgent             String?
  completedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user                  User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan                  ProductPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  voucher               Voucher?      @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  licenseKeys           LicenseKey[]
  transaction           Transaction?

  @@index([orderCode])
  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([createdAt])
}

model LicenseKey {
  id                    String        @id @default(uuid())
  key                   String        @unique
  userId                String
  orderId               String?
  planId                String
  status                KeyStatus     @default(UNACTIVATED)
  hwid                  String?
  maxDevices            Int           @default(1)
  activatedAt           DateTime?
  expiresAt             DateTime?
  durationSeconds       BigInt        @default(2592000)
  isFirstUseCounted     Boolean       @default(false)
  lastHeartbeatAt       DateTime?
  lastIp                String?
  clientVersion         String?
  hwidResetsUsed        Int           @default(0)
  banReason             String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  order                 Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  plan                  ProductPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  hwidLogs              HwidLog[]
  sessions              ClientSession[]

  @@index([key])
  @@index([userId])
  @@index([status])
  @@index([hwid])
  @@index([expiresAt])
}

model HwidLog {
  id                    String        @id @default(uuid())
  licenseKeyId          String
  oldHwid               String?
  newHwid               String
  reason                String?
  feeCharged            Decimal       @default(0.00) @db.Decimal(10, 2)
  resetBy               ResetByType   @default(USER)
  ipAddress             String?
  createdAt             DateTime      @default(now())

  licenseKey            LicenseKey    @relation(fields: [licenseKeyId], references: [id], onDelete: Cascade)

  @@index([licenseKeyId])
  @@index([createdAt])
}

model ClientSession {
  id                    String        @id @default(uuid())
  licenseKeyId          String
  sessionToken          String        @unique
  hwid                  String
  ipAddress             String?
  clientVersion         String?
  lastPingAt            DateTime      @default(now())
  expiresAt             DateTime
  createdAt             DateTime      @default(now())

  licenseKey            LicenseKey    @relation(fields: [licenseKeyId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
  @@index([licenseKeyId])
  @@index([expiresAt])
}

model Transaction {
  id                    String            @id @default(uuid())
  transCode             String            @unique
  referenceId           String?           @unique
  userId                String
  orderId               String?           @unique
  type                  TransactionType   @default(DEPOSIT)
  amount                Decimal           @db.Decimal(14, 2)
  balanceBefore         Decimal           @db.Decimal(14, 2)
  balanceAfter          Decimal           @db.Decimal(14, 2)
  status                TransactionStatus @default(PENDING)
  provider              PaymentProvider   @default(VIETQR)
  description           String?           @db.Text
  rawWebhookData        Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user                  User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  order                 Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([transCode])
  @@index([referenceId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model SoftwareRelease {
  id                    String          @id @default(uuid())
  version               String          @unique
  channel               ReleaseChannel  @default(STABLE)
  title                 String
  changelog             String          @db.Text
  downloadUrl           String
  installerType         String          @default("PORTABLE_ZIP")
  fileSizeBytes         BigInt          @default(0)
  sha256Checksum        String
  isForceUpdate         Boolean         @default(false)
  isServerMaintenance   Boolean         @default(false)
  maintenanceMessage    String?         @db.Text
  downloadCount         Int             @default(0)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([version])
  @@index([channel])
  @@index([createdAt])
}

model Ticket {
  id                    String          @id @default(uuid())
  ticketNumber          String          @unique
  userId                String
  subject               String
  priority              TicketPriority  @default(MEDIUM)
  status                TicketStatus    @default(OPEN)
  lastRepliedAt         DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages              TicketMessage[]

  @@index([ticketNumber])
  @@index([userId])
  @@index([status])
}

model TicketMessage {
  id                    String          @id @default(uuid())
  ticketId              String
  senderId              String
  senderRole            UserRole        @default(USER)
  message               String          @db.Text
  attachmentUrl         String?
  isInternalNote        Boolean         @default(false)
  createdAt             DateTime        @default(now())

  ticket                Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender                User            @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
}

model AuditLog {
  id                    String          @id @default(uuid())
  userId                String?
  action                String
  targetResource        String
  targetId              String?
  ipAddress             String?
  userAgent             String?
  details               Json?
  createdAt             DateTime        @default(now())

  user                  User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
